# Backend Environment Configuration
# Copy this file to backend/.env and fill in your values

# Server Configuration
PORT=3000
HOST=localhost
NODE_ENV=development

# Bitcoin RPC Configuration
BITCOIN_RPC_URL=http://localhost:8332
BITCOIN_RPC_USER=your_rpc_username
BITCOIN_RPC_PASS=your_rpc_password

# Rate Limiting (milliseconds)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Optional: Database (if using persistent storage)
# DATABASE_URL=postgresql://user:password@localhost:5432/permanentspeech

# Optional: Logging
LOG_LEVEL=info

# Optional: API Keys for additional services
# MEMPOOL_API_URL=https://mempool.space/api
